process {
    executor = 'slurm'
    queue = 'cancergen'
    cpus = 6
    memory = '30 GB'
    time = '12h'

    beforeScript = 'module load singularity'

    container = '/dcs07/scharpf/data/horjuela/dcs10_horjuela/scripts/MethID-1.0.2/methid.sif'

    withName: 'MODKIT_PILEUP' {
        cpus = 4
        memory = '115 GB'
        time = '10h'
        maxForks = 4
    }

    withName: 'BEDMETHYL_TO_SHORTBED' {
        stageInMode = 'copy'
	errorStrategy = 'retry'
        maxRetries = 2
        time = '2h'
        memory = '16 GB'
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = "-B /dcs10,/dcl01,/dcs05,/dcs07"
}
