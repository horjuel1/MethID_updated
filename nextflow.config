process {
    executor = 'slurm'
    queue = 'cancergen,shared'
    cpus = 4
    memory = '32.GB'
    time = '12h'
    container = methid.sif

    withName: 'MODKIT_PILEUP' {
        cpus = 4
        memory = '115.GB'
        time = '10h'
        maxForks = 4
    }

    withName: 'BEDMETHYL_TO_SHORTBED' {
        stageInMode = 'copy'
    }

    // build_atlas.nf processes (resources from smMethID); retries double the memory
    withName: 'BUILD_ATLAS' {
        memory = { 64.GB * task.attempt }
        time = { 24.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withName: 'ATLAS_BETA_BINOMIAL_FIT|ATLAS_SEPARABILITY' {
        cpus = 2
        memory = { 32.GB * task.attempt }
        time = { 4.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withName: 'BEDMETHYL_TO_SHORTBED|MOD_PILEUP_TO_SHORTBED' {
        errorStrategy = 'retry'
        maxRetries = 2
        time = '2h'
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = "-B /dcl01,/dcs05,/dcs07,/dcs10,/dcs11"
}
